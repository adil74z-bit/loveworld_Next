# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file (it is already in .gitignore).

# --- Supabase (PUBLIC values only) ---------------------------------------
# Supabase Dashboard -> Project Settings -> API
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon / public" key. It is safe in the browser
# ONLY because Row Level Security protects the data.
# DO NOT put the "service_role" key here or anywhere in this project.
# Anything starting with VITE_ is shipped to the browser and visible to everyone.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Firebase (from Phase 0; only needed if you keep Firebase) -----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
