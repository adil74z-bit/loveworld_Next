rules_version = '2';

// Starter security rules: a signed-in player can only read and write THEIR OWN data.
// Deploy these from the Firebase console (Firestore -> Rules) when you reach Phase 1.
service cloud.firestore {
  match /databases/{database}/documents {

    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /worlds/{ownerUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
